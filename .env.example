# Copy to .env and replace every `change-me`.
# Generate a password with: openssl rand -hex 24  (hex is URL-safe, so it can go in a URL)

# --- Application ---
APP_NAME=News API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# --- Outbound HTTP for ingestion (optional; defaults shown) ---
# USER_AGENT=news-platform-api/<version> (+https://github.com/IsmailAISSAMI/news-platform-api)
# HTTP_CONNECT_TIMEOUT_S=5
# HTTP_TOTAL_TIMEOUT_S=20
# HTTP_MAX_RESPONSE_BYTES=5242880
# HTTP_MIN_DELAY_S=1        # robots.txt Crawl-delay can only raise this
# HTTP_MAX_ATTEMPTS=3

# --- Database: PostgreSQL on Neon (docs/architecture.md 5.6) ---
# Neon console -> Connect -> Connection pooling OFF (no "-pooler" in the host). Paste the
# connection string as shown; `postgresql://` is read with the psycopg driver.
DATABASE_URL=postgresql://neondb_owner:change-me@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# The only database setting: the app, the API, migrations, backups and the daily GitHub
# run (secret DATABASE_URL, environment `production`) all use this one string.
# Optional, not used today: a login for the API alone (docs/architecture.md 5.6). Leave it
# unset. Only an API started with ENVIRONMENT=production needs it: it then refuses to
# start unless this is set to a `news_api_login` URL (scripts/db_login_passwords.sql).
# API_DATABASE_URL=postgresql://news_api_login:change-me@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Local test database (docker compose `db`): tests only, never the app ---
# Tests create `<db>_test` on this server and refuse to run against Neon.
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news
# Must use the same user, password and database as above. Port 5433 is the compose mapping.
TEST_DATABASE_URL=postgresql+psycopg://news:change-me@localhost:5433/news

# Host port of the API container (docker compose `api`). Use 8001 if 8000 is taken.
# API_PORT=8000

# --- Backups (optional; defaults shown) ---
# BACKUP_DIR=~/Backups/news          # keep it outside the repo and outside iCloud
# BACKUP_KEEP=14
# BACKUP_MAX_AGE_DAYS=7
# How pg_dump/pg_restore run. With the default, a local server is reached through the
# `db` container and Neon through a throwaway postgres:18-alpine container (password and
# TLS passed in the environment, never on a command line). "" = host-installed tools.
# PG_TOOLS_COMMAND=docker compose exec -T db

# --- AI analysis: Gemini API, free tier only (see docs/architecture.md 5.5) ---
# Put the real key in .env, never here: this file is public.
# Keep billing OFF on the Google project, so nothing can ever be charged.
GEMINI_API_KEY=change-me
# Replace change-me with a real key in .env before `news analyze` or `news lab`.
# GEMINI_MODEL=gemma-4-31b-it
# Defaults to the constant GEMINI_BASE_URL in app/analysis/llm.py (the only allowed value);
# any other value is refused. Leave it unset.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MAX_REQUESTS_PER_RUN=3       # `news lab`: 3 answered requests per test (max 3)
# GEMINI_MAX_REQUESTS_PER_DAY=1000    # 7% of Google's 14.4K/day for Gemma 4 31B
# These limits can only be lowered: the code refuses higher values.
# GEMINI_MAX_REQUESTS_PER_MINUTE=20         # 2/3 of Google's 30
# GEMINI_MAX_INPUT_TOKENS_PER_MINUTE=10000  # under 2/3 of Google's 16K
# GEMINI_CONCURRENCY=8                      # articles in flight in `news analyze` (max 8)
