# --- Application ---
APP_NAME=News API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# --- Database (used by the app when running on the host) ---
DATABASE_URL=postgresql+psycopg://news:change-me@localhost:5433/news

# --- Postgres container (docker compose). Keep in sync with DATABASE_URL.
# Use URL-safe characters in the password. ---
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news
