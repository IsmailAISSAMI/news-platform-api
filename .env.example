# Copy to .env and replace every `change-me`.
# Generate a password with: openssl rand -hex 24  (hex is URL-safe, so it can go in DATABASE_URL)

# --- Application ---
APP_NAME=News API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# --- Outbound HTTP for ingestion (optional; defaults shown) ---
# USER_AGENT=news-platform-api/<version> (+https://github.com/IsmailAISSAMI/news-platform-api)
# HTTP_CONNECT_TIMEOUT_S=5
# HTTP_TOTAL_TIMEOUT_S=20
# HTTP_MAX_RESPONSE_BYTES=5242880
# HTTP_MIN_DELAY_S=1        # robots.txt Crawl-delay can only raise this
# HTTP_MAX_ATTEMPTS=3

# Host port of the API container (docker compose). Use 8001 if 8000 is taken.
# API_PORT=8000

# --- Optional: read-only database user for the API ---
# The API's connections are read-only either way. Setting this adds a privilege layer:
# news_api_login, a login in the SELECT-only news_api role. Create it with
# scripts/db_roles.sql, set its password with scripts/db_login_passwords.sql (README,
# "Owner setup after round 3"), then put that password here in .env.
# API_DATABASE_URL=postgresql+psycopg://news_api_login:change-me@localhost:5433/news
# The same login for the Docker `api` service (host `db`, port 5432). Empty = owner login.
# DOCKER_API_DATABASE_URL=postgresql+psycopg://news_api_login:change-me@db:5432/news

# --- Backups (optional; defaults shown) ---
# BACKUP_DIR=~/Backups/news          # keep it outside the repo and outside iCloud
# BACKUP_KEEP=14
# BACKUP_MAX_AGE_DAYS=7
# PG_TOOLS_COMMAND=docker compose exec -T db   # "" to use host-installed pg_dump

# --- Postgres container (docker compose) ---
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news

# --- Database URL used by the app, migrations and tests on the host ---
# Must use the same user, password and database as above. Port 5433 is the compose mapping.
DATABASE_URL=postgresql+psycopg://news:change-me@localhost:5433/news

# --- AI analysis: Gemini API, free tier only (see docs/architecture.md 5.5) ---
# Put the real key in .env, never here: this file is public.
# Keep billing OFF on the Google project, so nothing can ever be charged.
GEMINI_API_KEY=change-me
# Replace change-me with a real key in .env before `news analyze` or `news lab`.
# GEMINI_MODEL=gemma-4-31b-it
# Must equal the constant GEMINI_BASE_URL in app/analysis/llm.py: any other value is refused.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MAX_REQUESTS_PER_RUN=3       # `news lab`: 3 answered requests per test (max 3)
# GEMINI_MAX_REQUESTS_PER_DAY=1000    # 7% of Google's 14.4K/day for Gemma 4 31B
# These limits can only be lowered: the code refuses higher values.
# GEMINI_MAX_REQUESTS_PER_MINUTE=20         # 2/3 of Google's 30
# GEMINI_MAX_INPUT_TOKENS_PER_MINUTE=10000  # under 2/3 of Google's 16K
# GEMINI_CONCURRENCY=8                      # articles in flight in `news analyze` (max 8)
